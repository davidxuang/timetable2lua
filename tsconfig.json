{
  "compilerOptions": {
    "target": "es2020",
    "useDefineForClassFields": true,
    "module": "node16",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "node16",
    "strict": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
